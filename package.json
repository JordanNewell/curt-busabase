{
	"name": "curt-busabase",
	"version": "1.0.1",
	"description": "Convert Busabase record review trails (change requests, reviews, comments) to .curt conversation files",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"bin": {
		"curt-busabase": "dist/cli.js"
	},
	"main": "dist/busabase.js",
	"types": "dist/busabase.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"prepack": "npm run build"
	},
	"dependencies": {
		"curt-format": "^1.2.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.6.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"curt",
		"busabase",
		"converter",
		"agents",
		"review-trail"
	],
	"repository": {
		"url": "https://github.com/JordanNewell/curt-busabase.git",
		"type": "git"
	}
}
